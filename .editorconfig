root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_ignore_back_ticked_identifier = true
# Measured separately on 2026-09-30; retain rules that exceed 10 changed files or fail auto-format.
# Enabled: argument wrapping and function literals (10 and 0 changed files).
ktlint_standard_function-literal = enabled
ktlint_standard_argument-list-wrapping = enabled
# 32 files changed; keep disabled to limit formatting churn.
ktlint_standard_function-signature = disabled
# Individual auto-format run failed; retain the existing layout.
ktlint_standard_function-expression-body = disabled
# 16 files changed; keep disabled to limit formatting churn.
ktlint_standard_class-signature = disabled
# Individual auto-format run failed; retain the existing layout.
ktlint_standard_multiline-expression-wrapping = disabled
# Individual auto-format run failed; retain the existing layout.
ktlint_standard_chain-method-continuation = disabled
# 85 files changed; keep disabled to limit formatting churn.
ktlint_standard_no-empty-first-line-in-class-body = disabled
# 21 files changed; keep disabled to limit formatting churn.
ktlint_standard_import-ordering = disabled
# 23 files changed; keep disabled to limit formatting churn.
ktlint_standard_blank-line-before-declaration = disabled
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
